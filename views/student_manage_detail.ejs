<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>내 제출물 - <%= assignment.title %></title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="topbar">
    <a href="/" class="brand">📚 과제 제출 사이트</a>
  </header>

  <div class="container">
    <div class="card">
      <h1><%= assignment.title %></h1>
      <p class="muted">제출자: <%= submission.student_name %><% if (submission.student_number) { %> (<%= submission.student_number %>)<% } %></p>

      <% if (typeof justUpdated !== 'undefined' && justUpdated) { %>
        <div class="success-box">✅ 파일이 재제출되었습니다.</div>
      <% } %>
      <% if (error) { %>
        <div class="error-box"><%= error %></div>
      <% } %>

      <table>
        <tr><th>현재 제출 파일</th><td><%= submission.original_filename %></td></tr>
        <tr><th>최초 제출</th><td><%= submission.submitted_at %></td></tr>
        <% if (submission.updated_at) { %><tr><th>마지막 수정</th><td><%= submission.updated_at %></td></tr><% } %>
      </table>
    </div>

    <div class="card">
      <h2>파일 재제출</h2>
      <p class="muted">새 파일을 올리면 기존 제출 파일은 새 파일로 교체됩니다.</p>
      <form method="POST" action="/assignments/<%= assignment.id %>/manage/<%= submission.id %>/resubmit" enctype="multipart/form-data">
        <label for="file">새 파일 선택</label>
        <input type="file" id="file" name="file" required />
        <button type="submit">재제출하기</button>
      </form>
    </div>

    <div class="card">
      <h2>제출물 삭제</h2>
      <p class="muted">삭제하면 되돌릴 수 없습니다.</p>
      <form method="POST" action="/assignments/<%= assignment.id %>/manage/<%= submission.id %>/delete"
            onsubmit="return confirm('정말 삭제하시겠습니까? 되돌릴 수 없습니다.');">
        <button type="submit" class="btn-danger">삭제하기</button>
      </form>
    </div>
  </div>
</body>
</html>
