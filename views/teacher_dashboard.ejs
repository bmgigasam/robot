<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>교사 대시보드</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="topbar">
    <a href="/teacher/dashboard" class="brand">📚 과제함 (교사)</a>
    <form method="POST" action="/teacher/logout" style="margin:0;">
      <button type="submit" class="btn-secondary" style="margin-top:0;">로그아웃 (<%= teacherUsername %>)</button>
    </form>
  </header>

  <div class="container">
    <div style="display:flex; justify-content:space-between; align-items:center;">
      <h1>과제 목록</h1>
      <a href="/teacher/assignments/new" class="btn">+ 새 과제 등록</a>
    </div>

    <div class="card">
      <% if (assignments.length === 0) { %>
        <p class="muted">등록된 과제가 없습니다. 새 과제를 등록해보세요.</p>
      <% } else { %>
        <% assignments.forEach(a => { %>
          <div class="assignment-row">
            <div>
              <a href="/teacher/assignments/<%= a.id %>"><%= a.title %></a>
              <% if (a.due_date) { %>
                <div class="muted" style="font-size:13px;">마감일: <%= a.due_date %></div>
              <% } %>
            </div>
            <span class="badge"><%= a.submission_count %>건 제출</span>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>
</body>
</html>
