<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= assignment.title %> - 과제 제출</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="topbar">
    <a href="/" class="brand">📚 과제함</a>
  </header>

  <div class="container">
    <div class="card">
      <h1><%= assignment.title %></h1>
      <% if (assignment.description) { %><p><%= assignment.description %></p><% } %>
      <% if (assignment.due_date) { %><p class="muted">마감일: <%= assignment.due_date %></p><% } %>
    </div>

    <div class="card">
      <h2>과제 제출하기</h2>
      <form method="POST" action="/assignments/<%= assignment.id %>/submit" enctype="multipart/form-data">
        <div class="form-group">
          <label for="student_name">이름 *</label>
          <input type="text" id="student_name" name="student_name" required placeholder="홍길동" />
        </div>

        <div class="form-group">
          <label for="student_number">학번 *</label>
          <input type="text" id="student_number" name="student_number" required placeholder="10101" />
        </div>

        <div class="form-group">
          <label for="password">비밀번호 * (제출물 수정/삭제 시 필요)</label>
          <input type="password" id="password" name="password" required placeholder="비밀번호 설정" />
        </div>

        <div class="form-group">
          <label for="file">과제 파일 첨부 *</label>
          <input type="file" id="file" name="file" required />
        </div>

        <div class="form-group" style="margin-top: 15px;">
          <label for="comment">선생님께 남길 메모 (선택사항)</label>
          <textarea id="comment" name="comment" rows="3" placeholder="제출 관련 참고사항이나 메모를 입력하세요." style="width: 100%; padding: 8px; box-sizing: border-box; font-family: inherit; margin-top: 5px;"></textarea>
        </div>

        <button type="submit" class="btn" style="margin-top: 20px;">과제 제출하기</button>
      </form>
    </div>
  </div>
</body>
</html>
