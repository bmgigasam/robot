<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>새 과제 등록</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="topbar">
    <a href="/teacher/dashboard" class="brand">📚 과제함 (교사)</a>
  </header>

  <div class="container">
    <div class="card">
      <h1>새 과제 등록</h1>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="error-box"><%= error %></div>
      <% } %>

      <form method="POST" action="/teacher/assignments">
        <label for="title">과제 제목 *</label>
        <input type="text" id="title" name="title" required />

        <label for="description">과제 설명</label>
        <textarea id="description" name="description" placeholder="제출 방법, 유의사항 등을 적어주세요."></textarea>

        <label for="due_date">마감일</label>
        <input type="date" id="due_date" name="due_date" />

        <button type="submit">등록하기</button>
      </form>
    </div>
  </div>
</body>
</html>
