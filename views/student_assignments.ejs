<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>과제 제출</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="topbar">
    <span class="brand">📚 과제 제출 사이트</span>
  </header>

  <div class="container">
    <h1>제출할 과제를 선택하세요</h1>
    <div class="card">
      <% if (assignments.length === 0) { %>
        <p class="muted">현재 등록된 과제가 없습니다.</p>
      <% } else { %>
        <% assignments.forEach(a => { %>
          <div class="assignment-row">
            <div>
              <a href="/assignments/<%= a.id %>"><%= a.title %></a>
              <% if (a.due_date) { %>
                <div class="muted" style="font-size:13px;">마감일: <%= a.due_date %></div>
              <% } %>
              <div class="muted" style="font-size:13px;"><a href="/assignments/<%= a.id %>/manage" style="color: var(--muted);">내 제출물 확인/수정</a></div>
            </div>
            <a href="/assignments/<%= a.id %>" class="btn" style="margin-top:0;">제출하기</a>
          </div>
        <% }) %>
      <% } %>
    </div>
    <p class="muted" style="text-align:center; margin-top:32px;"><a href="/teacher/login" style="color: var(--muted);">교사 로그인</a></p>
  </div>
</body>
</html>
